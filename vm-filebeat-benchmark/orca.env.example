# Copy to orca.env (gitignored). Precedence: process environment, --env-file,
# orca.env, then config.yaml variables.

# Provider and TF_VAR_* must be the same for up, bench, and down.
ORCA_PROVIDER=gcp
TF_VAR_owner=yourname
TF_VAR_gcp_project=your-gcp-project
#TF_VAR_operator_cidr=1.2.3.4/32
#TF_VAR_agent_machine_type=e2-highcpu-2
#TF_VAR_gcp_zone=us-central1-a
# Extra labels for GCP resources, for orgs that require them (JSON map).
#TF_VAR_labels={"division":"engineering","org":"obs","team":"yourteam"}

# Remote Elasticsearch that receives filebeat's monitoring data; the port is
# required (Elastic Cloud serves on 443). The cluster needs
# xpack.monitoring.collection.enabled: true.
ES_URL=https://my-deployment.es.us-central1.gcp.cloud.es.io:443
ES_USER=elastic
ES_PASSWORD=changeme

# Required: local path to a flog binary (https://github.com/mingrammer/flog)
# matching the agent VM's architecture (amd64 for the GCP default, arm64 for
# multipass on Apple Silicon).
FLOG_BINARY_PATH=/path/to/flog

# Optional: your own filebeat tar.gz (matching the VM's architecture); when
# unset, FILEBEAT_VERSION is downloaded.
#FILEBEAT_TARBALL_PATH=/path/to/filebeat-linux-x86_64.tar.gz
#FILEBEAT_VERSION=9.5.6

# Log burst generated fresh at each bench's warmup.
#FLOG_FILE_COUNT=10
#FLOG_LINES_PER_FILE=500000
#FLOG_FORMAT=apache_common
