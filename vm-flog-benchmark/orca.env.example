# Copy to orca.env (gitignored) to override the defaults in config.yaml
# without exporting anything. Precedence: process environment, --env-file,
# orca.env, then config.yaml variables.

# Provider and TF_VAR_* must be the same for up, bench, and down.
ORCA_PROVIDER=gcp
TF_VAR_owner=yourname
# Number of elastic-agent VMs (1, 2, 4, or 8); no generator VMs in this benchmark.
TF_VAR_agent_count=4
# Agents that run in each bench (the first N, <= agent_count). Provision 8 at up
# and override per bench: ACTIVE_AGENT_COUNT=2 orca bench
ACTIVE_AGENT_COUNT=4
#TF_VAR_operator_cidr=1.2.3.4/32
#TF_VAR_agent_machine_type=e2-highcpu-2
# When a zone reports "does not have enough resources", change gcp_zone;
# all VMs stay in the same zone so cross-zone latency doesn't skew results.
#TF_VAR_gcp_zone=us-central1-f

# Required: local path to a flog binary (https://github.com/mingrammer/flog)
# matching the agent VMs' architecture (amd64 for the GCP default, arm64 for
# multipass on Apple Silicon). flog ships no arm64 release, so build one with
# `go install github.com/mingrammer/flog@latest` on an arm64 host if needed.
FLOG_BINARY_PATH=/path/to/flog

# Stack versions installed at up.
#ELASTIC_VERSION=9.6.0-SNAPSHOT
#AGENT_VERSION=9.2.8
# elastic-agent self-monitoring sample interval (agent default 60s).
#AGENT_METRICS_PERIOD=15s

# Per-agent-VM log burst, generated fresh at each bench's warmup.
FLOG_FILE_COUNT=5
FLOG_LINES_PER_FILE=1000
#FLOG_FORMAT=apache_common
